# ──────────────────────────────────────────────────────────────────────────────
# Linkery — пример переменных окружения
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase — Project Settings → API → anon (public) key
# Этот ключ безопасно использовать в браузере (RLS защищает данные)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase — Project Settings → API → service_role (secret) key
# ⚠️ НИКОГДА не передавайте этот ключ в браузер
# Используется только на сервере (API routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL вашего приложения (для редиректов после OAuth и email-ссылок)
# Локально: http://localhost:3000
# Продакшн: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
